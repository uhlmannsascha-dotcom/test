      const saved = localStorage.getItem("xal_meeting_actions");
      return saved ? JSON.parse(saved) : INITIAL_MEETING_ACTIONS;
    } catch {
      return INITIAL_MEETING_ACTIONS;
    }
  });

  const [scenarios, setScenarios] = useState(() => {
    try {
      const saved = localStorage.getItem("xal_scenarios");
      return saved ? JSON.parse(saved) : INITIAL_SCENARIOS;
    } catch {
      return INITIAL_SCENARIOS;
    }
  });

  const [lastSaved, setLastSaved] = useState(new Date().toLocaleTimeString());

  useEffect(() => {
    try {
      localStorage.setItem("xal_strategic_areas", JSON.stringify(strategicAreas));
      localStorage.setItem("xal_standard_steps", JSON.stringify(standardSteps));
      localStorage.setItem("xal_wardley_links", JSON.stringify(wardleyLinks));
      localStorage.setItem("xal_wardley_vectors", JSON.stringify(wardleyVectors));
      localStorage.setItem("xal_work_packages", JSON.stringify(workPackages));
      localStorage.setItem("xal_risks", JSON.stringify(risks));
      localStorage.setItem("xal_kpis", JSON.stringify(kpis));
      localStorage.setItem("xal_okrs", JSON.stringify(okrs));
      localStorage.setItem("xal_meeting_actions", JSON.stringify(meetingActions));
      localStorage.setItem("xal_scenarios", JSON.stringify(scenarios));
      setLastSaved(new Date().toLocaleTimeString());
    } catch (e) {
      console.error("Auto-save failed", e);
    }
  }, [strategicAreas, standardSteps, wardleyLinks, wardleyVectors, workPackages, risks, kpis, okrs, meetingActions, scenarios]);

  const handleExportJSON = () => {
    const bundle = {
      timestamp: new Date().toISOString(),
      version: "3.2",
      strategicAreas,
      standardSteps,
      wardleyLinks,
      wardleyVectors,
      workPackages,
      risks,
      kpis,
      okrs,
      meetingActions,
      scenarios
    };
    const blob = new Blob([JSON.stringify(bundle, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = `XAL_Operations_Backup_${new Date().toISOString().slice(0, 10)}.json`;
    link.click();
    URL.revokeObjectURL(url);
  };

  const handleImportJSON = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      try {
        const parsed = JSON.parse(event.target.result);
        if (parsed.strategicAreas) setStrategicAreas(parsed.strategicAreas);
        if (parsed.standardSteps) setStandardSteps(parsed.standardSteps);
        if (parsed.wardleyLinks) setWardleyLinks(parsed.wardleyLinks);
        if (parsed.wardleyVectors) setWardleyVectors(parsed.wardleyVectors);
        if (parsed.workPackages) setWorkPackages(parsed.workPackages);
        if (parsed.risks) setRisks(parsed.risks);
        if (parsed.kpis) setKpis(parsed.kpis);
        if (parsed.okrs) setOkrs(parsed.okrs);
        if (parsed.meetingActions) setMeetingActions(parsed.meetingActions);
        if (parsed.scenarios) setScenarios(parsed.scenarios);
      } catch (err) {
        console.error("Failed to parse JSON backup", err);
      }
    };
    reader.readAsText(file);
  };

  const [wardleyLayerFilter, setWardleyLayerFilter] = useState("all"); // 'all' | 'standard' | 'initiatives'
  const [isWardleyFullscreen, setIsWardleyFullscreen] = useState(false);
  const [selectedWardleyNode, setSelectedWardleyNode] = useState(null);

  // Drag state with grab offset calculation
  const [draggingNode, setDraggingNode] = useState(null);
  const wardleyCanvasRef = useRef(null);

  // Connection Mode (click source node, then target node)
  const [isConnectMode, setIsConnectMode] = useState(false);
  const [connectSourceId, setConnectSourceId] = useState(null);

  // Dashboard Filters
  const [selectedKpiCategory, setSelectedKpiCategory] = useState("All");

  // Modals state
  const [isEditAreaModal, setIsEditAreaModal] = useState(false);
  const [editingArea, setEditingArea] = useState(null);

  const [isEditStandardStepModal, setIsEditStandardStepModal] = useState(false);
  const [editingStandardStep, setEditingStandardStep] = useState(null);

  const [isEditVectorModal, setIsEditVectorModal] = useState(false);
  const [editingVector, setEditingVector] = useState(null);

  const [isLinksManagerModal, setIsLinksManagerModal] = useState(false);
  const [newLinkSource, setNewLinkSource] = useState("");
  const [newLinkTarget, setNewLinkTarget] = useState("");
  const [newLinkLabel, setNewLinkLabel] = useState("");

  const [isDeleteModalOpen, setIsDeleteModalOpen] = useState(false);
  const [deleteTarget, setDeleteTarget] = useState(null); // { type, id, name }

  const [strategicViewMode, setStrategicViewMode] = useState("cards"); // 'cards' | 'table' | 'gantt'
  const [isEditRiskModal, setIsEditRiskModal] = useState(false);
  const [editingRisk, setEditingRisk] = useState(null);

  const [isWpModalOpen, setIsWpModalOpen] = useState(false);
  const [editingWpData, setEditingWpData] = useState(null);

  const [wpViewMode, setWpViewMode] = useState("kanban"); // 'kanban' | 'gantt' | 'table'

  const [isEditKpiModal, setIsEditKpiModal] = useState(false);
  const [editingKpi, setEditingKpi] = useState(null);
  const [isKpiSelectorModal, setIsKpiSelectorModal] = useState(false);

  const getStrategicAreaDates = (area) => {
    let start = area.startDate;
    let end = area.endDate;
    if ((!start || !end) && area.timeline) {
      const dates = area.timeline.match(/\d{4}-\d{2}-\d{2}/g);
      if (dates && dates.length >= 2) {
        start = start || dates[0];
        end = end || dates[1];
      }
    }
    if (!start || !end) return null;
    const startMs = new Date(start).getTime();
    const endMs = new Date(end).getTime();
    if (isNaN(startMs) || isNaN(endMs) || startMs >= endMs) return null;
    return { start, end, startMs, endMs };
  };

  const allRawNodes = useMemo(() => {
    const areas = strategicAreas.map((a) => ({
      id: a.id,
      name: `${a.id}: ${a.title}`,
      type: "Initiative",
      evolutionX: a.evolutionX ?? 50,
      visibilityY: a.visibilityY ?? 50,
      owner: a.owner,
      showOnMap: a.showOnMap !== false,
      raw: a
    }));

    const steps = standardSteps.map((s) => ({
      id: s.id,
      name: s.name,
      type: "Standard Step",
      evolutionX: s.evolutionX ?? 50,
      visibilityY: s.visibilityY ?? 50,
      owner: s.owner,
      showOnMap: true,
      raw: s
    }));

    return [...steps, ...areas];
  }, [strategicAreas, standardSteps]);

  const visibleWardleyNodes = useMemo(() => {
    return allRawNodes.filter((n) => {
      if (!n.showOnMap) return false;
      if (wardleyLayerFilter === "standard") return n.type === "Standard Step";
      if (wardleyLayerFilter === "initiatives") return n.type === "Initiative";
      return true;
    });
  }, [allRawNodes, wardleyLayerFilter]);

  const nodePositionMap = useMemo(() => {
    const map = {};
    allRawNodes.forEach((n) => {
      map[n.id] = { x: n.evolutionX, y: n.visibilityY, name: n.name, type: n.type };
    });
    return map;
  }, [allRawNodes]);

  const handleMouseDownNode = (node, e) => {
    e.stopPropagation();

    if (isConnectMode) {
      if (!connectSourceId) {
        setConnectSourceId(node.id);
      } else if (connectSourceId !== node.id) {
        const newLink = {
          id: `WL-${Date.now()}`,
          from: connectSourceId,
          to: node.id,
          label: "depends on"
        };
        setWardleyLinks((prev) => [...prev, newLink]);
        setConnectSourceId(null);
        setIsConnectMode(false);
      }
      return;
    }

    if (!wardleyCanvasRef.current) return;
    const rect = wardleyCanvasRef.current.getBoundingClientRect();
    const cursorX = ((e.clientX - rect.left) / rect.width) * 100;
    const cursorY = 100 - ((e.clientY - rect.top) / rect.height) * 100;

    setDraggingNode({
      id: node.id,
      offsetX: node.evolutionX - cursorX,
      offsetY: node.visibilityY - cursorY
    });
  };

  const handleCanvasMouseMove = (e) => {
    if (!draggingNode || !wardleyCanvasRef.current) return;
    const rect = wardleyCanvasRef.current.getBoundingClientRect();
    const cursorX = ((e.clientX - rect.left) / rect.width) * 100;
    const cursorY = 100 - ((e.clientY - rect.top) / rect.height) * 100;

    const newX = Math.max(5, Math.min(95, Math.round(cursorX + draggingNode.offsetX)));
    const newY = Math.max(8, Math.min(95, Math.round(cursorY + draggingNode.offsetY)));

    if (draggingNode.id.startsWith("VC-")) {
      setStandardSteps((prev) =>
        prev.map((s) => (s.id === draggingNode.id ? { ...s, evolutionX: newX, visibilityY: newY } : s))
      );
    } else {
      setStrategicAreas((prev) =>
        prev.map((a) => (a.id === draggingNode.id ? { ...a, evolutionX: newX, visibilityY: newY } : a))
      );
    }
  };

  const handleCanvasMouseUp = () => setDraggingNode(null);

  const executeDelete = () => {
    if (!deleteTarget) return;
    const { type, id } = deleteTarget;

    if (type === "strategicArea" || type === "area") {
      setStrategicAreas((prev) => prev.filter((a) => a.id !== id));
      setWardleyLinks((prev) => prev.filter((l) => l.from !== id && l.to !== id));
      setWardleyVectors((prev) => prev.filter((v) => v.fromNodeId !== id));
    } else if (type === "standardStep" || type === "standard") {
      setStandardSteps((prev) => prev.filter((s) => s.id !== id));
      setWardleyLinks((prev) => prev.filter((l) => l.from !== id && l.to !== id));
      setWardleyVectors((prev) => prev.filter((v) => v.fromNodeId !== id));
    } else if (type === "vector") {
      setWardleyVectors((prev) => prev.filter((v) => v.id !== id));
    } else if (type === "link") {
      setWardleyLinks((prev) => prev.filter((l) => l.id !== id));
    } else if (type === "workPackage") {
      setWorkPackages((prev) => prev.filter((w) => w.id !== id));
    } else if (type === "risk") {
      setRisks((prev) => prev.filter((r) => r.id !== id));
    } else if (type === "kpi") {
      setKpis((prev) => prev.filter((k) => k.id !== id));
    } else if (type === "action") {
      setMeetingActions((prev) => prev.filter((a) => a.actionId !== id));
    }

    setIsDeleteModalOpen(false);
    setDeleteTarget(null);
    setSelectedWardleyNode(null);
  };

  const getStatusBadge = (status) => {
    switch (status) {
      case "On Target":
      case "In Progress":
      case "Active":
        return "bg-emerald-500/15 text-emerald-400 border-emerald-500/30";
      case "Warning":
      case "In Preparation":
      case "Planned":
      case "Open":
        return "bg-amber-500/15 text-amber-400 border-amber-500/30";
      case "Critical":
      case "Very High":
      case "Overdue":
        return "bg-rose-500/15 text-rose-400 border-rose-500/30";
      default:
