                  onChange={(e) => setEditingStandardStep({ ...editingStandardStep, name: e.target.value })}
                  className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                />
              </div>
              <div>
                <label className="block text-slate-400 mb-1">Operational Owner</label>
                <input
                  type="text"
                  value={editingStandardStep.owner}
                  onChange={(e) => setEditingStandardStep({ ...editingStandardStep, owner: e.target.value })}
                  className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                />
              </div>
              <div className="p-3 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2">
                <span className="font-bold text-cyan-400 block text-[11px]">Map Position Sliders</span>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="text-slate-400 block text-[10px]">Evolution X: {editingStandardStep.evolutionX}%</label>
                    <input
                      type="range"
                      min="5"
                      max="95"
                      value={editingStandardStep.evolutionX ?? 50}
                      onChange={(e) => setEditingStandardStep({ ...editingStandardStep, evolutionX: parseInt(e.target.value, 10) })}
                      className="w-full accent-cyan-500"
                    />
                  </div>
                  <div>
                    <label className="text-slate-400 block text-[10px]">Visibility Y: {editingStandardStep.visibilityY}%</label>
                    <input
                      type="range"
                      min="8"
                      max="95"
                      value={editingStandardStep.visibilityY ?? 50}
                      onChange={(e) => setEditingStandardStep({ ...editingStandardStep, visibilityY: parseInt(e.target.value, 10) })}
                      className="w-full accent-cyan-500"
                    />
                  </div>
                </div>
              </div>
              <div>
                <label className="block text-slate-400 mb-1">Description</label>
                <textarea
                  rows={2}
                  value={editingStandardStep.description}
                  onChange={(e) => setEditingStandardStep({ ...editingStandardStep, description: e.target.value })}
                  className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                />
              </div>
            </div>
            <div className="flex justify-end gap-2 pt-3 border-t border-slate-800">
              <button onClick={() => setIsEditStandardStepModal(false)} className="px-3 py-1.5 bg-slate-800 rounded text-xs">Cancel</button>
              <button
                onClick={() => {
                  setStandardSteps((prev) => {
                    const exists = prev.some((s) => s.id === editingStandardStep.id);
                    if (exists) return prev.map((s) => (s.id === editingStandardStep.id ? editingStandardStep : s));
                    return [...prev, editingStandardStep];
                  });
                  setIsEditStandardStepModal(false);
                }}
                className="px-3.5 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded text-xs font-semibold"
              >
                Save Component
              </button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL: EDIT / ADD IMPROVEMENT VECTOR */}
      {isEditVectorModal && editingVector && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
          <div className={`p-6 rounded-2xl border max-w-md w-full space-y-4 shadow-2xl ${cardBgClass}`}>
            <h3 className="text-sm font-bold text-white">Improvement Vector ({editingVector.id})</h3>
            <div className="space-y-3 text-xs">
              <div>
                <label className="block text-slate-400 mb-1">Origin Node (From)</label>
                <select
                  value={editingVector.fromNodeId}
                  onChange={(e) => setEditingVector({ ...editingVector, fromNodeId: e.target.value })}
                  className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                >
                  {allRawNodes.map((n) => (
                    <option key={n.id} value={n.id}>{n.name}</option>
                  ))}
                </select>
              </div>
              <div>
                <label className="block text-slate-400 mb-1">Target Evolution State Name</label>
                <input
                  type="text"
                  value={editingVector.targetName}
                  onChange={(e) => setEditingVector({ ...editingVector, targetName: e.target.value })}
                  className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                />
              </div>
              <div>
                <div className="flex justify-between text-slate-400 mb-1">
                  <span>Target Evolution X Position: {editingVector.targetX}%</span>
                </div>
                <input
                  type="range"
                  min="10"
                  max="95"
                  value={editingVector.targetX ?? 75}
                  onChange={(e) => setEditingVector({ ...editingVector, targetX: parseInt(e.target.value, 10) })}
                  className="w-full accent-rose-500"
                />
              </div>
              <div>
                <label className="block text-slate-400 mb-1">Strategic Annotation Description</label>
                <textarea
                  rows={3}
                  value={editingVector.annotation}
                  onChange={(e) => setEditingVector({ ...editingVector, annotation: e.target.value })}
                  className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                />
              </div>
            </div>

            <div className="flex justify-between pt-3 border-t border-slate-800">
              <button
                onClick={() => {
                  setDeleteTarget({ type: "vector", id: editingVector.id, name: `Vector #${editingVector.num}: ${editingVector.targetName}` });
                  setIsEditVectorModal(false);
                  setIsDeleteModalOpen(true);
                }}
                className="text-rose-400 text-xs font-semibold"
              >
                Delete Vector
              </button>
              <div className="flex gap-2">
                <button onClick={() => setIsEditVectorModal(false)} className="px-3 py-1.5 bg-slate-800 rounded text-xs">Cancel</button>
                <button
                  onClick={() => {
                    setWardleyVectors((prev) => {
                      const exists = prev.some((v) => v.id === editingVector.id);
                      if (exists) return prev.map((v) => (v.id === editingVector.id ? editingVector : v));
                      return [...prev, editingVector];
                    });
                    setIsEditVectorModal(false);
                  }}
                  className="px-3.5 py-1.5 bg-rose-600 hover:bg-rose-500 text-white rounded text-xs font-semibold"
                >
                  Save Vector
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* MODAL: LINKS & DEPENDENCIES MANAGER */}
      {isLinksManagerModal && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
          <div className={`p-6 rounded-2xl border max-w-lg w-full space-y-4 shadow-2xl ${cardBgClass}`}>
            <h3 className="text-sm font-bold text-white">Dependency Links Manager</h3>
            <div className="p-3 rounded-xl bg-slate-950 border border-slate-800 space-y-2 text-xs">
              <span className="font-bold text-cyan-400 block">Add New Dependency Arrow</span>
              <div className="grid grid-cols-2 gap-2">
                <div>
                  <label className="text-slate-400 block mb-0.5">From (Source)</label>
                  <select
                    value={newLinkSource}
                    onChange={(e) => setNewLinkSource(e.target.value)}
                    className="w-full p-1.5 rounded border bg-slate-900 border-slate-800 text-white"
                  >
                    {allRawNodes.map((n) => (
                      <option key={n.id} value={n.id}>{n.name}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="text-slate-400 block mb-0.5">To (Target)</label>
                  <select
                    value={newLinkTarget}
                    onChange={(e) => setNewLinkTarget(e.target.value)}
                    className="w-full p-1.5 rounded border bg-slate-900 border-slate-800 text-white"
                  >
                    {allRawNodes.map((n) => (
                      <option key={n.id} value={n.id}>{n.name}</option>
                    ))}
                  </select>
                </div>
              </div>
              <button
                onClick={() => {
                  if (newLinkSource && newLinkTarget && newLinkSource !== newLinkTarget) {
                    setWardleyLinks((prev) => [
                      ...prev,
                      { id: `WL-${Date.now()}`, from: newLinkSource, to: newLinkTarget, label: newLinkLabel || "depends on" }
                    ]);
                  }
                }}
                className="w-full py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded font-bold"
              >
                + Connect Dependency
              </button>
            </div>

            <div className="max-h-56 overflow-y-auto space-y-1.5 text-xs">
              <span className="font-bold text-slate-400 block">Active Connection Links ({wardleyLinks.length})</span>
              {wardleyLinks.map((link) => (
                <div key={link.id} className="p-2 rounded bg-slate-950 border border-slate-800 flex items-center justify-between">
                  <span className="font-mono text-cyan-400">{link.from} → {link.to}</span>
                  <button
                    onClick={() => setWardleyLinks((prev) => prev.filter((l) => l.id !== link.id))}
                    className="text-slate-400 hover:text-rose-400 p-1"
                    title="Remove connection arrow"
                  >
                    <Trash2 size={13} />
                  </button>
                </div>
              ))}
            </div>

            <div className="flex justify-end pt-3 border-t border-slate-800">
              <button onClick={() => setIsLinksManagerModal(false)} className="px-3.5 py-1.5 bg-slate-800 rounded text-xs font-semibold">Close</button>
            </div>
          </div>
        </div>
      )}

      {}
      {/* MODAL: EDIT / ADD RISK */}
      {isEditRiskModal && editingRisk && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
          <div className={`p-6 rounded-2xl border max-w-lg w-full space-y-4 shadow-2xl ${cardBgClass}`}>
            <div className="flex items-center justify-between pb-2 border-b border-slate-800">
              <h3 className="text-sm font-bold text-white">Risk Profile ({editingRisk.id})</h3>
              <button onClick={() => setIsEditRiskModal(false)} className="text-slate-400 hover:text-white">
                <X size={16} />
              </button>
            </div>
            <div className="space-y-3 text-xs">
              <div>
                <label className="block text-slate-400 mb-1">Risk Title / Description</label>
                <input
                  type="text"
                  value={editingRisk.title}
                  onChange={(e) => setEditingRisk({ ...editingRisk, title: e.target.value })}
                  className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                />
              </div>
              <div className="grid grid-cols-2 gap-2">
                <div>
                  <label className="block text-slate-400 mb-1">Category</label>
                  <select
                    value={editingRisk.category}
                    onChange={(e) => setEditingRisk({ ...editingRisk, category: e.target.value })}
                    className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                  >
                    <option value="Supplier Risk">Supplier Risk</option>
                    <option value="Quality Risk">Quality Risk</option>
                    <option value="Capacity Risk">Capacity Risk</option>
                    <option value="Machine Risk">Machine Risk</option>
                    <option value="Digital/ERP Risk">Digital/ERP Risk</option>
                  </select>
                </div>
                <div>
                  <label className="block text-slate-400 mb-1">Owner</label>
                  <input
                    type="text"
                    value={editingRisk.owner}
                    onChange={(e) => setEditingRisk({ ...editingRisk, owner: e.target.value })}
                    className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                  />
                </div>
              </div>
              <div className="grid grid-cols-3 gap-2 p-2.5 rounded-xl bg-slate-950 border border-slate-800">
                <div>
                  <label className="block text-slate-400 mb-1">Probability (1-5)</label>
                  <input
                    type="number"
                    min="1"
                    max="5"
                    value={editingRisk.probability}
                    onChange={(e) => {
                      const prob = parseInt(e.target.value, 10) || 1;
                      const score = prob * (editingRisk.impact || 1);
                      setEditingRisk({ ...editingRisk, probability: prob, riskScore: score });
                    }}
                    className="w-full p-1.5 rounded border bg-slate-900 border-slate-700 text-white font-mono"
                  />
                </div>
                <div>
                  <label className="block text-slate-400 mb-1">Impact (1-5)</label>
                  <input
                    type="number"
                    min="1"
                    max="5"
                    value={editingRisk.impact}
                    onChange={(e) => {
                      const imp = parseInt(e.target.value, 10) || 1;
                      const score = (editingRisk.probability || 1) * imp;
                      setEditingRisk({ ...editingRisk, impact: imp, riskScore: score });
                    }}
                    className="w-full p-1.5 rounded border bg-slate-900 border-slate-700 text-white font-mono"
                  />
                </div>
                <div>
                  <label className="block text-slate-400 mb-1">Calculated Score</label>
                  <div className="p-1.5 font-bold font-mono text-rose-400 bg-slate-900 rounded border border-slate-700 text-center">
                    {editingRisk.riskScore || editingRisk.probability * editingRisk.impact}
                  </div>
                </div>
              </div>
              <div>
                <label className="block text-slate-400 mb-1">Mitigation Actions</label>
                <textarea
                  rows={2}
                  value={editingRisk.mitigation}
                  onChange={(e) => setEditingRisk({ ...editingRisk, mitigation: e.target.value })}
                  className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                />
              </div>
            </div>
            <div className="flex justify-end gap-2 pt-3 border-t border-slate-800">
              <button onClick={() => setIsEditRiskModal(false)} className="px-3 py-1.5 bg-slate-800 rounded text-xs">Cancel</button>
              <button
                onClick={() => {
                  setRisks((prev) => {
                    const exists = prev.some((r) => r.id === editingRisk.id);
                    if (exists) return prev.map((r) => (r.id === editingRisk.id ? editingRisk : r));
                    return [...prev, editingRisk];
                  });
                  setIsEditRiskModal(false);
                }}
                className="px-3.5 py-1.5 bg-rose-600 hover:bg-rose-500 text-white rounded text-xs font-semibold"
              >
                Save Risk
              </button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL: KPI SELECTOR (CHOOSE VISIBLE KPIS ON DASHBOARD) */}
      {isKpiSelectorModal && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
          <div className={`p-6 rounded-2xl border max-w-md w-full space-y-4 shadow-2xl ${cardBgClass}`}>
            <div className="flex items-center justify-between pb-2 border-b border-slate-800">
              <h3 className="text-sm font-bold text-white">Dashboard KPI Visibility</h3>
              <button onClick={() => setIsKpiSelectorModal(false)} className="text-slate-400 hover:text-white">
                <X size={16} />
              </button>
            </div>
            <div className="space-y-2 max-h-72 overflow-y-auto pr-1 text-xs">
              {kpis.map((kpi) => (
                <label key={kpi.id} className="flex items-center justify-between p-2 rounded border bg-slate-950/60 border-slate-800 cursor-pointer">
                  <div className="flex items-center gap-2">
                    <input
                      type="checkbox"
                      checked={kpi.showOnDashboard !== false}
                      onChange={(e) => {
                        const checked = e.target.checked;
                        setKpis((prev) => prev.map((k) => (k.id === kpi.id ? { ...k, showOnDashboard: checked } : k)));
                      }}
                      className="accent-cyan-500 rounded"
                    />
                    <span>{kpi.name}</span>
                  </div>
                  <span className="font-mono text-cyan-400">{kpi.value}</span>
                </label>
              ))}
            </div>
            <div className="flex justify-end pt-3 border-t border-slate-800">
              <button onClick={() => setIsKpiSelectorModal(false)} className="px-4 py-1.5 bg-cyan-600 text-white rounded text-xs font-semibold">Done</button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL: EDIT / ADD MANUAL KPI */}
      {isEditKpiModal && editingKpi && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
          <div className={`p-6 rounded-2xl border max-w-md w-full space-y-4 shadow-2xl ${cardBgClass}`}>
            <div className="flex items-center justify-between pb-2 border-b border-slate-800">
              <h3 className="text-sm font-bold text-white">Manual KPI Data Entry ({editingKpi.id})</h3>
              <button onClick={() => setIsEditKpiModal(false)} className="text-slate-400 hover:text-white">
                <X size={16} />
              </button>
            </div>
            <div className="space-y-3 text-xs">
              <div>
                <label className="block text-slate-400 mb-1">Metric Name</label>
                <input
                  type="text"
                  value={editingKpi.name}
                  onChange={(e) => setEditingKpi({ ...editingKpi, name: e.target.value })}
                  className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                />
              </div>
              <div className="grid grid-cols-2 gap-2.5 p-3 rounded-xl bg-slate-950 border border-slate-800">
                <div>
                  <label className="block text-cyan-400 font-bold mb-1">Current Value (Manual)</label>
                  <input
                    type="text"
                    value={editingKpi.value}
                    onChange={(e) => setEditingKpi({ ...editingKpi, value: e.target.value })}
                    className="w-full p-2 rounded border bg-slate-900 border-slate-700 text-white font-mono font-bold"
                  />
                </div>
                <div>
                  <label className="block text-slate-300 font-semibold mb-1">Target Value</label>
                  <input
                    type="text"
                    value={editingKpi.target}
                    onChange={(e) => setEditingKpi({ ...editingKpi, target: e.target.value })}
                    className="w-full p-2 rounded border bg-slate-900 border-slate-700 text-white font-mono"
                  />
                </div>
              </div>
              <div className="grid grid-cols-2 gap-2">
                <div>
                  <label className="block text-slate-400 mb-1">Status</label>
                  <select
                    value={editingKpi.status}
                    onChange={(e) => setEditingKpi({ ...editingKpi, status: e.target.value })}
                    className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                  >
                    <option value="On Target">On Target</option>
                    <option value="Warning">Warning</option>
                    <option value="Critical">Critical</option>
                  </select>
                </div>
                <div>
                  <label className="block text-slate-400 mb-1">Trend</label>
                  <input
                    type="text"
                    value={editingKpi.trend}
                    onChange={(e) => setEditingKpi({ ...editingKpi, trend: e.target.value })}
                    className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                  />
                </div>
              </div>
            </div>
            <div className="flex justify-end gap-2 pt-3 border-t border-slate-800">
              <button onClick={() => setIsEditKpiModal(false)} className="px-3 py-1.5 bg-slate-800 rounded text-xs">Cancel</button>
              <button
                onClick={() => {
                  setKpis((prev) => {
                    const exists = prev.some((k) => k.id === editingKpi.id);
                    if (exists) return prev.map((k) => (k.id === editingKpi.id ? editingKpi : k));
                    return [...prev, editingKpi];
                  });
                  setIsEditKpiModal(false);
                }}
                className="px-3.5 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded text-xs font-semibold"
              >
                Save KPI
              </button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL: ADD / EDIT WORK PACKAGE */}
      {isWpModalOpen && editingWpData && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
          <div className={`p-6 rounded-2xl border max-w-lg w-full space-y-4 shadow-2xl ${cardBgClass}`}>
            <h3 className="text-sm font-bold text-white">Work Package ({editingWpData.id})</h3>
            <div className="space-y-3 text-xs">
              <div>
                <label className="block text-slate-400 mb-1">Title</label>
                <input
                  type="text"
                  value={editingWpData.title}
                  onChange={(e) => setEditingWpData({ ...editingWpData, title: e.target.value })}
                  className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                />
              </div>
              <div className="grid grid-cols-2 gap-2">
                <div>
                  <label className="block text-slate-400 mb-1">Strategic Area</label>
                  <select
                    value={editingWpData.strategicAreaId}
                    onChange={(e) => setEditingWpData({ ...editingWpData, strategicAreaId: e.target.value })}
                    className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                  >
                    {strategicAreas.map((a) => (
                      <option key={a.id} value={a.id}>{a.id} - {a.title}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="block text-slate-400 mb-1">Owner</label>
                  <input
                    type="text"
                    value={editingWpData.owner}
                    onChange={(e) => setEditingWpData({ ...editingWpData, owner: e.target.value })}
                    className="w-full p-2 rounded border bg-slate-950 border-slate-800 text-white"
                  />
                </div>
              </div>
            </div>
            <div className="flex justify-end gap-2 pt-3 border-t border-slate-800">
              <button onClick={() => setIsWpModalOpen(false)} className="px-3 py-1.5 bg-slate-800 rounded text-xs">Cancel</button>
              <button
                onClick={() => {
                  setWorkPackages((prev) => {
                    const exists = prev.some((w) => w.id === editingWpData.id);
                    if (exists) return prev.map((w) => (w.id === editingWpData.id ? editingWpData : w));
                    return [...prev, editingWpData];
                  });
                  setIsWpModalOpen(false);
                }}
                className="px-3.5 py-1.5 bg-cyan-600 text-white rounded text-xs font-semibold"
              >
                Save Package
              </button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL: SAFE DELETE CONFIRMATION */}
      {isDeleteModalOpen && deleteTarget && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
          <div className={`p-6 rounded-2xl border max-w-sm w-full space-y-4 shadow-2xl ${cardBgClass}`}>
            <h3 className="text-sm font-bold text-white">Confirm Removal</h3>
            <p className="text-xs text-slate-300">
              Permanently remove <strong className="text-white">{deleteTarget.name}</strong> and remove any linked dependencies?
            </p>
            <div className="flex justify-end gap-2 pt-3 border-t border-slate-800">
              <button onClick={() => setIsDeleteModalOpen(false)} className="px-3 py-1.5 bg-slate-800 rounded text-xs">Cancel</button>
              <button onClick={executeDelete} className="px-3.5 py-1.5 bg-rose-600 text-white rounded text-xs font-semibold">Delete</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
